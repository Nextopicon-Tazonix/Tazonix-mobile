{
  "expo": {
    "name": "Tazonix",
    "slug": "tazonix",
    "scheme": "tazonix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0F2C",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tazonix.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Tazonix needs access to your photos and videos so you can upload portfolio items and competition entries.",
        "NSCameraUsageDescription": "Tazonix uses the camera to record competition entries and portfolio media."
      }
    },
    "android": {
      "package": "com.tazonix.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0F2C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      "expo-video",
      "expo-web-browser",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#0A0F2C"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Tazonix needs access to your photos and videos so you can upload portfolio items and competition entries."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "78db5bc9-ee00-486d-97cd-19dcba16eda6"
      }
    }
  }
}
